# ---------------------------------------------------------------------------
# Valenzuela CRS — backend configuration
# Copy this file to .env and adjust if your XAMPP setup differs.
#   cp .env.example .env      (Windows: copy .env.example .env)
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5050
# Origins allowed by CORS — comma-separated list. In development, any
# localhost/127.0.0.1 port and private LAN address (192.168.x, 10.x,
# 172.16-31.x) is additionally allowed so the app also works when opened
# from 127.0.0.1 or from a phone on the same Wi-Fi. Production only
# allows the origins listed here.
CLIENT_URL=http://localhost:5173

# MySQL (XAMPP defaults: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=valenzuela_crs

# TLS — only needed for a hosted MySQL that requires it (Aiven, TiDB Serverless,
# RDS, …). Leave DB_SSL unset for local XAMPP; the pool then connects exactly
# as before, with no TLS.
#   DB_SSL=true          TLS with server-certificate verification
#   DB_SSL_CA=./ca.pem   CA bundle used for verification (Aiven/TiDB provide one;
#                        path is relative to the backend folder)
#   DB_SSL=skip-verify   TLS without certificate verification (debugging only)
# DB_SSL=true
# DB_SSL_CA=./ca.pem

# Uploaded files (announcements, community posts, reports, lost & found).
#   local (default) — files are written to backend/uploads/ (dev with XAMPP).
#   s3              — files go to an S3-compatible bucket (Cloudflare R2, AWS S3,
#                     Backblaze B2, MinIO …) and are streamed back through
#                     /uploads/… so stored URLs never change.
# For s3, all four S3_* values are required:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=valenzuela-crs-uploads
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=true   # only if your provider needs path-style URLs (MinIO)

# JWT — replace both secrets with long random strings before deploying.
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
# Access token lifetime (zeit/ms format: 15m, 1h, 7d)
JWT_ACCESS_TTL=15m
# Refresh token lifetime without "Remember me"
JWT_REFRESH_TTL_DAYS=7
# Refresh token lifetime with "Remember me" ticked
JWT_REMEMBER_TTL_DAYS=30

# Password reset link validity, in minutes
RESET_TOKEN_TTL_MINUTES=60

# Uploads
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_VIDEO_MB=40
UPLOAD_MAX_FILES=6

# Google Gemini — powers the AI Barangay Help Desk (server-side only).
# Create a key in Google AI Studio: https://ai.google.dev/gemini-api/docs/api-key
# Leave GEMINI_API_KEY empty to fall back to the built-in rules-based assistant.
GEMINI_API_KEY=
# Lightweight, low-cost model — see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
