# ---------------------------------------------------------------------------
# Valenzuela CRS — backend configuration
# Copy this file to .env and adjust if your XAMPP setup differs.
#   cp .env.example .env      (Windows: copy .env.example .env)
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5050
# Origins allowed by CORS — comma-separated list. In development, any
# localhost/127.0.0.1 port and private LAN address (192.168.x, 10.x,
# 172.16-31.x) is additionally allowed so the app also works when opened
# from 127.0.0.1 or from a phone on the same Wi-Fi. Production only
# allows the origins listed here.
CLIENT_URL=http://localhost:5173

# MySQL (XAMPP defaults: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=valenzuela_crs

# JWT — replace both secrets with long random strings before deploying.
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
# Access token lifetime (zeit/ms format: 15m, 1h, 7d)
JWT_ACCESS_TTL=15m
# Refresh token lifetime without "Remember me"
JWT_REFRESH_TTL_DAYS=7
# Refresh token lifetime with "Remember me" ticked
JWT_REMEMBER_TTL_DAYS=30

# Password reset link validity, in minutes
RESET_TOKEN_TTL_MINUTES=60

# Uploads
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_VIDEO_MB=40
UPLOAD_MAX_FILES=6

# Google Gemini — powers the AI Barangay Help Desk (server-side only).
# Create a key in Google AI Studio: https://ai.google.dev/gemini-api/docs/api-key
# Leave GEMINI_API_KEY empty to fall back to the built-in rules-based assistant.
GEMINI_API_KEY=
# Lightweight, low-cost model — see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest
