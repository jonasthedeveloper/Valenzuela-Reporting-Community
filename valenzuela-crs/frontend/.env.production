# Baked into the production bundle by `vite build` (mode=production).
# The API is served from this same Vercel deployment, so the frontend calls
# its own origin — same-origin cookies, no CORS. VITE_* values are public
# (they end up in the JS bundle); never put secrets here.
#
# VITE_API_URL is what src/services/api.js uses as the axios baseURL (it wins
# over VITE_API_ORIGIN), so both must point at this deployment.
VITE_API_URL=https://valenzuela-reporting-community.vercel.app/api
VITE_API_ORIGIN=https://valenzuela-reporting-community.vercel.app
