# ---------------------------------------------------------------------------
# Valenzuela CRS — frontend configuration
# Copy this file to .env before running npm run dev.
#   cp .env.example .env      (Windows: copy .env.example .env)
# ---------------------------------------------------------------------------

# Base URL of the Express API. Must match PORT in backend/.env.
VITE_API_URL=http://localhost:5050/api

# Origin used by the Vite dev proxy for uploaded photos and videos.
VITE_API_ORIGIN=http://localhost:5050

# Name shown in the sidebar and on the auth pages.
VITE_APP_NAME=Valenzuela Community Reporting System
VITE_APP_TAGLINE=Ulat, Maagap, Alisto
