{
  "name": "Valenzuela Community Reporting System",
  "short_name": "Valenzuela CRS",
  "description": "Report community issues, track barangay requests, and chat with the Barangay Help Desk in Valenzuela City.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#1d4ed8",
  "background_color": "#f4f7fb",
  "categories": ["government", "utilities", "news"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Help Desk",
      "short_name": "Help Desk",
      "url": "/messages",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Create report",
      "short_name": "Report",
      "url": "/reports/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
